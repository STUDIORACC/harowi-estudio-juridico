# ---------------------------------------------------------------------------
# ESTUDIO JURÍDICO — Variables de entorno
# Copiar este archivo como `.env.local` y completar los valores.
# ---------------------------------------------------------------------------

# URL pública del sitio. Se usa en metadata, Open Graph, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
# Sin estas dos variables el sitio arranca en MODO DEMOSTRACIÓN: se muestra el
# contenido de `src/content`, los formularios validan pero no guardan y el panel
# queda en solo lectura. Con ellas, todo el contenido pasa a leerse y escribirse
# en la base de datos.
#
# Se obtienen en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. SOLO para scripts del lado servidor (`npm run seed`).
# Nunca debe exponerse al navegador ni subirse al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WHATSAPP CLOUD API (opcional, integración preparada en src/lib/whatsapp.ts)
# ---------------------------------------------------------------------------
# El sitio funciona con enlaces wa.me y no necesita credenciales. Estas
# variables solo hacen falta para enviar mensajes desde el servidor.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
